# GEMINI_API_KEY: Required for Gemini AI API calls.
# This is a placeholder key.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
# IMPORTANT: Uncomment the line below if your app uses the Gemini API.
# If left commented out, the key will NOT be packaged in the APK.
# GEMINI_API_KEY=MY_GEMINI_API_KEY

# NESHAN_API_KEY: Required for real Neshan map/routing calls
# (NeshanApiService: static map image + /v4/direction distance & duration).
# Get a real key from https://platform.neshan.org and put it in a local
# `.env` file (gitignored, never committed). This placeholder value keeps
# the BuildConfig.NESHAN_API_KEY field available even without a real .env.
NESHAN_API_KEY=REPLACE_WITH_REAL_NESHAN_API_KEY

# SERVER_BASE_URL: The web panel's server address (step 4 of the
# app<->panel coordination plan). Must include the scheme and a trailing
# slash, e.g. "https://your-panel-domain.com/" or, for local testing on an
# Android emulator talking to a server on your own machine, "http://10.0.2.2:3000/".
SERVER_BASE_URL=REPLACE_WITH_REAL_SERVER_URL

# DRIVER_API_KEY: Must be the EXACT SAME value as DRIVER_API_KEY in the web
# panel's own .env file — this is the shared secret that authenticates the
# driver app against the panel's /api/v1/driver/* and /api/v1/orders/* endpoints.
DRIVER_API_KEY=REPLACE_WITH_A_LONG_RANDOM_SECRET
